<section class="main-banner"
{% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 2400 }}');"
  {% endif %}
>
<div class="main-container">
<h1>
    {% if section.settings.h1-heading != blank %}
    {{ section.settings.h1-heading }}
      {% endif %}
</h1>
<p>
    {% if section.settings.para != blank %}
    {{ section.settings.para }}
      {% endif %}
</p>
<a href="   {% if section.settings.btn-text != blank %} {{ section.settings.url }}">{{ section.settings.btn-text }} {% endif %} </a>
</div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
    },
    {
      "type": "text",
      "id": "h1-heading",
      "label": "t:settings.heading",
    },
     {
      "type": "text",
      "id": "para",
      "label": "paragraph",
    }
],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
