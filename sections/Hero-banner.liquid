<section class="main-banner"
{% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 2400 }}');"
  {% endif %}
>
<div class="main-container">
<h1>
    {{ section.settings.h1-heading }}
</h1>
<p>
    {{ section.settings.para }}
</p>
<a href="{{ section.settings.url }}">{{ section.settings.btn-text }}</a>
</div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
    }
],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
