<section
  class="custom-hero-banner"
  {% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 2400 }}');"
  {% endif %}
>
  <div class="custom-hero-banner__content">
    {% if section.settings.h1_heading != blank %}
      <h1>{{ section.settings.h1_heading }}</h1>
    {% endif %}

    {% if section.settings.para != blank %}
      <p>{{ section.settings.para }}</p>
    {% endif %}

    {% if section.settings.btn_text != blank %}
      <a
        href="{{ section.settings.url }}"
        class="custom-hero-banner__button"
      >
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
</section>


{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "h1_heading",
      "label": "Heading",
      "default": "Your heading here"
    },
    {
      "type": "textarea",
      "id": "para",
      "label": "Description",
      "default": "Add your banner description here."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}