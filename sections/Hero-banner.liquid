<section
  class="custom-hero-banner"
  {% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 2400 }}');"
  {% endif %}
>
  <div class="custom-hero-banner__content">
    {% if section.settings.h1_heading != blank %}
      <h1>{{ section.settings.h1_heading }}</h1>
    {% endif %}

    {% if section.settings.para != blank %}
      <p>{{ section.settings.para }}</p>
    {% endif %}

    {% if section.settings.btn_text != blank %}
      <a
        href="{{ section.settings.url }}"
        class="custom-hero-banner__button"
      >
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .custom-hero-banner {
    position: relative;
    width: 100%;
    min-height: 600px;

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    align-items: flex-end;
    justify-content: flex-start;

    overflow: hidden;
  }

  .custom-hero-banner__content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 650px;

    padding: 60px;
    color: #ffffff;
  }

  .custom-hero-banner__content h1 {
    margin: 0 0 18px;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
    font-weight: 700;
  }

  .custom-hero-banner__content p {
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.5;
    max-width: 550px;
  }

  .custom-hero-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;

  min-width: 134px;
  height: 31px;
  padding: 0 14px 0 32px;

  background: #000;
  color: #fff;
  border: none;
  border-radius: 0;

  text-decoration: none;
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0.3px;

  transition: all 0.3s ease;
}

.custom-hero-banner__button::after {
  content: '→';
  font-size: 19px;
  line-height: 1;
  transition: transform 0.3s ease;
}

.custom-hero-banner__button:hover {
  background: #000;
  color: #fff;
}

.custom-hero-banner__button:hover::after {
  transform: translateX(5px);
}
  @media screen and (max-width: 749px) {
    .custom-hero-banner {
      min-height: 500px;
      background-position: center;
    }

    .custom-hero-banner__content {
      padding: 30px 20px;
      max-width: 100%;
    }

    .custom-hero-banner__content h1 {
      font-size: 38px;
    }

    .custom-hero-banner__content p {
      font-size: 16px;
    }

    .custom-hero-banner__button {
      padding: 12px 22px;
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "h1_heading",
      "label": "Heading",
      "default": "Your heading here"
    },
    {
      "type": "textarea",
      "id": "para",
      "label": "Description",
      "default": "Add your banner description here."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}